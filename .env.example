# ==============================================================================
# Virel AI (AIStudio Web Hook Gateway) — Environment Configuration
# ==============================================================================

# Custom API Key clients must provide in Authorization: Bearer <key>
VIREL_API_KEY=your-secret-gateway-api-key-here

# Persistent browser profile folder (where Google account login is stored)
CHROME_PROFILE_DIR=./runtime/browser-profile

# Run browser in headless mode:
# true  = silent background process (no window)
# false = visible browser window
HEADLESS=true

# Default model name
DEFAULT_MODEL=gemini-flash-latest

# Optional rendered Markdown reconstruction; false keeps the original plain text reader.
VIREL_PRESERVE_MARKDOWN=false

# Default thinking level; native request reasoning overrides this when supported
THINKING_MODE=high

# Upper ceiling; available RAM can reduce active requests below this value.
VIREL_MAX_CONCURRENT=20
VIREL_MAX_QUEUE=100
VIREL_QUEUE_TIMEOUT_SECONDS=120
# Conservative growth headroom per active task, not measured per-tab usage.
VIREL_MEMORY_RESERVE_MB=1024
VIREL_TAB_MEMORY_MB=512
# Waiting client-tool pages release execution admission but still use memory.
VIREL_MAX_WAITING_TABS=20

# Rate limiting per IP (slowapi)
VIREL_RATE_LIMIT=30/minute

# Google Search grounding default; chat/completions can override via request headers
ENABLE_SEARCH_GROUNDING=false

# Enable the selected model's URL Context tool for links in prompts
ENABLE_URL_CONTEXT=true

# Server Port
PORT=8001

# Gateway media limits (positive integers; MB values are MiB).
# Raising these cannot override AI Studio/model/account limits.
VIREL_MAX_PDF_MB=50
VIREL_MAX_PDF_PAGES=1000
VIREL_MAX_PDFS=10
VIREL_MAX_REQUEST_MB=128
VIREL_MAX_AUDIO_MB=25

# Video input limits; duration/context are also limited by the selected website model.
VIREL_MAX_VIDEO_MB=50
VIREL_MAX_VIDEOS=2
VIREL_MAX_VIDEO_PIXELS=20000000

# Actual observed AI Studio image model; gpt-image-1 is an explicit edit compatibility selector.
DEFAULT_IMAGE_MODEL=gemini-3.1-flash-lite-image
VIREL_MAX_GENERATED_IMAGE_MB=20

# Actual eligible AI Studio speech model/voice; native selectors are disclosed aliases.
DEFAULT_SPEECH_MODEL=gemini-3.8-flash-tts
DEFAULT_SPEECH_VOICE=Fola
VIREL_MAX_GENERATED_AUDIO_MB=50
VIREL_MAX_SPEECH_CHARACTERS=4096
VIREL_MAX_SPEECH_SECONDS=600

# Idle wait for client tool results; one active browser loop, no stored history.
VIREL_TOOL_RUN_TTL_SECONDS=600

# General file inputs and server-side text extraction (not website/model quotas).
VIREL_MAX_FILE_MB=50
VIREL_MAX_FILE_INPUTS=20
VIREL_MAX_DOCUMENT_TEXT_CHARS=2000000
VIREL_MAX_DOCUMENT_UNPACKED_MB=64
VIREL_MAX_DOCUMENT_CELLS=200000
VIREL_MAX_DOCUMENT_MEMORY_MB=512

# Multi-Account Quota Rotation:
# Number of Google accounts signed in to the Chromium profile (authuser=0, 1, 2...)
VIREL_GOOGLE_ACCOUNTS_COUNT=1
# Optional: explicit authuser indices (e.g. GOOGLE_ACCOUNTS=0,1,2) or separate profiles (CHROME_PROFILES=./profile1,./profile2)
# Cooldown in hours after an account hits daily limit before trying it again (default: 6)
VIREL_ACCOUNT_COOLDOWN_HOURS=6
