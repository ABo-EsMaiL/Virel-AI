# ==============================================================================
# Virel (AIStudio Web Hook Gateway) — Environment Configuration
# ==============================================================================

# Custom API Key clients must provide in Authorization: Bearer <key>
VIREL_API_KEY=your-secret-gateway-api-key-here

# Persistent browser profile folder (where Google account login is stored)
CHROME_PROFILE_DIR=./runtime/browser-profile

# Run browser in headless mode:
# true  = silent background process (no window)
# false = visible browser window
HEADLESS=true

# Default model name
DEFAULT_MODEL=gemini-3.8-flash

# Default thinking mode (high, medium, low, dynamic)
THINKING_MODE=high

# Admission limit; the single browser tab still processes one request at a time.
VIREL_MAX_CONCURRENT=1

# Rate limiting per IP (slowapi)
VIREL_RATE_LIMIT=30/minute

# Start a fresh browser chat for each request (recommended for independent clients)
CLEAR_CHAT_ON_REQUEST=true

# Google Search grounding default; chat/completions can override via request headers
ENABLE_SEARCH_GROUNDING=false

# Server Port
PORT=8001
